# Copy to .env and fill in. Never commit .env.

# OpenAI Realtime (the agent's voice and reasoning). Usage is billed per minute of audio.
OPENAI_API_KEY=

# Twilio (phone leg). Trial accounts can only call numbers verified on the account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The ONE phone number the demo may call (E.164). Scripts refuse any other destination.
APPROVED_CALL_NUMBER=

# Public HTTPS address of the backend (ngrok tunnel to port 8000). Changes when ngrok restarts.
PUBLIC_BASE_URL=

# Audit log for tool calls (every entry is marked mocked: true).
REDIAL_AUDIT_PATH=demo/audit.jsonl

# Optional: Vapi attempt (not used for the recorded calls; see LIMITATIONS.md).
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
